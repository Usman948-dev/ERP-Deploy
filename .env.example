# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# SQL Server 'sa' password. IMPORTANT: the old password (Usman5138@) was
# committed to source control in this project's git history and must be
# treated as compromised — set a brand new one here, not the old value.
DB_SA_PASSWORD=change_me_use_a_long_random_password

# Random secret used to sign auth tokens (see backend Security/TokenService.cs).
# Use at least 32 random characters. Changing this invalidates all existing
# login sessions.
AUTH_SIGNING_KEY=change_me_use_at_least_32_random_characters

# The address Caddy serves on (see Caddyfile). Leave as the bare IP for a
# self-signed certificate that works today, or set to a real domain name
# once you have one pointed at this server for a free trusted certificate
# (and remove "tls internal" from the Caddyfile when you do).
SITE_ADDRESS=157.173.96.166
# Comma-separated list of origins allowed to call the API directly.
# Normal traffic (browser -> Caddy -> frontend/API) is same-origin now and
# doesn't need CORS at all — this only matters if something calls the API
# cross-origin directly (e.g. a separate tool hitting the API by itself).
# Kept restrictive as defense-in-depth rather than left wide open.
CORS_ALLOWED_ORIGINS=https://157.173.96.166,http://localhost:5173

# Base URL used to build the link inside password-reset emails. Defaults to
# https://<SITE_ADDRESS> above if left unset, which is correct for most
# setups — only override this if your public URL differs from SITE_ADDRESS
# for some reason.
# FRONTEND_BASE_URL=https://157.173.96.166

# --- Password reset email (optional) ---
# Leave all of these unset and the app still works fine — "forgot password"
# requests are accepted normally, but no email actually goes out (logged as
# a warning instead). Fill these in with real SMTP credentials to enable it.
# Works with Gmail (use an App Password, not your real password), SendGrid,
# Mailgun, Amazon SES, Postmark, or your host's own mail server — anything
# that offers plain SMTP + username/password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=ERP System
SMTP_ENABLE_SSL=true
