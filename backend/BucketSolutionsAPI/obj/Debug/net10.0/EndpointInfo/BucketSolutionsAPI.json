            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "qty": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "requestedBy": {
            "type": "string"
          }
        }
      }
    }
