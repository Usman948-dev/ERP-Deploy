              "integer",
              "string"
            ],
            "format": "int32"
          },
          "barcode": {
            "type": "string"
          },
          "qtyReceived": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "costPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "SaleItem": {
        "type": "object",
        "properties": {
          "barcode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qty": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
